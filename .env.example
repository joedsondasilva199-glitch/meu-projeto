# ====================================================================
# STACK DE AGENTES PRO: ANTIGRAVITY + LINEAR BUSINESS + ORCA + HERMES
# ====================================================================

# 1. LINEAR (Conta Business)
# Obtenha sua chave em: https://linear.app/settings/api -> Personal API keys
# Permissões completas: Ler e escrever issues, projetos, comentários e ciclos
LINEAR_API_KEY=sua_linear_api_key_aqui

# Nome do projeto e time no Linear
LINEAR_TEAM_KEY=ENG
LINEAR_PROJECT_NAME=MeuProjeto

# 2. GITHUB
# Seu repositório no GitHub (ex: seu-usuario/seu-repositorio)
GITHUB_OWNER=joedsondasilva199-glitch
GITHUB_REPO=meu-projeto

# 3. ORCA (Executores CLI em Worktrees Isoladas)
# Caminho base dos workspaces do Orca
ORCA_WORKSPACE_BASE=C:\Users\Lipe\orca\workspaces
# Modelo padrão para os executores no Orca (ex: claude, codex)
ORCA_DEFAULT_AGENT=claude

# 4. RAILWAY (Opcional - Deploy de Produção)
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE=
