# Configurações do Backend DarkLab Reconstruído

# Ambiente e Servidor
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Segurança / Autenticação
JWT_SECRET=super_secret_jwt_key_darklab_rebuilt_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chaves de IA
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Supabase (Opcional - caso utilize banco em nuvem)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Banco de Dados Local (Padrão: SQLite WAL)
DATABASE_URL=sqlite+aiosqlite:///./darklab.db
